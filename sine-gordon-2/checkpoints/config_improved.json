{
    "data_file": "sine_gordon_dataset_200k.h5",
    "num_pendulums": 100,
    "num_timesteps": 10,
    "input_features": 2,
    "d_model": 32,
    "n_heads": 1,
    "n_layers": 16,
    "dim_feedforward": 32,
    "dropout": 0.2,
    "use_rope": true,
    "use_attention_sink": true,
    "num_sink_tokens": 2,
    "batch_size": 64,
    "num_epochs": 128,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "grad_clip": 5.0,
    "early_stopping_patience": 15,
    "train_ratio": 0.45,
    "val_ratio": 0.05,
    "loss_type": "soft_label",
    "soft_label_sigma": 1.65,
    "seed": 42
}